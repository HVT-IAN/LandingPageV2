# Copia este archivo a .env y cambia los valores
DATABASE_URL=sqlite:///./cms.db
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
COOKIE_SECURE=false          # true en producción (HTTPS)

# Orígenes permitidos para la landing, separados por coma.
# En producción agrega tu URL de GitHub Pages: https://TU-USUARIO.github.io
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Primer administrador (se crea solo si no existe ningún usuario)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-clave

# Correo del formulario de contacto (opcional; si SMTP_HOST está vacío solo se guarda el mensaje)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# Solo para el script de migración a Neon (descomenta y pega la URL de Neon):
# TARGET_DATABASE_URL=postgresql://usuario:clave@host/bd?sslmode=require

